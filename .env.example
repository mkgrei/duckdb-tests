# S3 / EKS audit log analysis (all optional — without S3_BUCKET the
# /api/s3/* endpoints return 503 and the rest of the app works as before)

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3 Configuration
S3_BUCKET=your-eks-audit-logs-bucket
S3_PREFIX=eks-audit-logs/

# Server Configuration (also settable via --host / --port CLI flags)
HOST=127.0.0.1
PORT=8000
